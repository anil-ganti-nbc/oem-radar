#!/usr/bin/env bash
# Print runtime identity/version, then health -- both against the local
# dev database (data/radar.db, created on first crawl; honestly reports
# "degraded" until then, which is correct, not a bug).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -x ".venv/bin/python" ]; then
    echo "error: no .venv found. Run mac/bootstrap first." >&2
    exit 1
fi

echo "=== identity ==="
.venv/bin/oem-radar identity
echo ""
echo "=== health ==="
.venv/bin/oem-radar health
