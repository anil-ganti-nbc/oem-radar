#!/usr/bin/env bash
# Set up (or reuse) a local macOS dev environment for OEM Radar.
# Safe to re-run: never destroys an existing .venv, only installs/updates deps.
#
# Native Python is the default dev path here on purpose (the existing
# Docker/Hetzner cloud setup stays as-is for deployment) -- Docker is
# optional, see README/ai/handoff/DEPLOYMENT_PROCEDURE.md if you want it.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

PYTHON_VERSION="3.12"

if ! command -v uv >/dev/null 2>&1; then
    echo "error: 'uv' is not installed or not on PATH." >&2
    echo "  Install it from https://docs.astral.sh/uv/ and re-run this script." >&2
    exit 1
fi

if [ -d ".venv" ]; then
    echo "==> Reusing existing .venv"
else
    echo "==> Creating .venv (Python $PYTHON_VERSION)"
    uv venv --python "$PYTHON_VERSION" .venv
fi

echo "==> Installing/updating dependencies (dev extras)"
uv pip install --python .venv/bin/python -e ".[dev]"

echo ""
echo "Bootstrap complete."
echo "  Local dev state lives in the project's own data/ dir (already gitignored)."
echo "  Next: mac/test, mac/health, mac/dashboard, or mac/run"
