#!/usr/bin/env bash
# Launch the OEM Radar dashboard locally, bound to localhost only, against
# the local dev database (data/radar.db).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -x ".venv/bin/python" ]; then
    echo "error: no .venv found. Run mac/bootstrap first." >&2
    exit 1
fi

PORT="${OEM_RADAR_MAC_PORT:-8930}"

echo "==> Dashboard: http://127.0.0.1:${PORT}/"
echo "    (Ctrl+C to stop)"
echo ""

exec .venv/bin/oem-radar dashboard --host 127.0.0.1 --port "$PORT" --no-browser
