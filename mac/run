#!/usr/bin/env bash
# Run one manual crawl against the local dev database (data/radar.db).
# Defaults to a single known-good source (beelink-shopify) rather than the
# full 28-OEM crawl or any disabled/problem source (e.g. dell-us-laptops,
# disabled for persistent bot protection -- not something to "fix" here).
#
# Usage:
#   mac/run                          # beelink-shopify, live
#   mac/run --source minisforum-shopify
#   mac/run --dry-run --source gpd-shopify
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [ ! -x ".venv/bin/python" ]; then
    echo "error: no .venv found. Run mac/bootstrap first." >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "==> No source specified; defaulting to --source beelink-shopify"
    exec .venv/bin/oem-radar run --source beelink-shopify
else
    exec .venv/bin/oem-radar run "$@"
fi
