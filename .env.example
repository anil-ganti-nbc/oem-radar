# OEM Radar Stage 1 environment template
# Copy to .env for local compose. Never commit real secrets.

# Discord notifications (optional; outbox queues if unset)
OEM_RADAR_DISCORD_WEBHOOK=

# Disable browser open inside containers (default in image)
OEM_RADAR_OPEN_BROWSER=0

# Optional absolute data root when not using relative ./data
# OEM_RADAR_DATA_DIR=/var/lib/oem-radar
